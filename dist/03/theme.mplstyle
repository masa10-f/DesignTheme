# Theme 03 Navy & Red (navy-red), status: active
# Generated by scripts/build.py from themes/03-navy-red/theme.json. Do not edit by hand.
# Colors: roles text / text-secondary / background. Color cycle: chart.series
# chart.series status: provisional (tentative proposal, needs review)

axes.prop_cycle: cycler('color', ['303967', 'E60012', '1DA561', 'C473C9', '007680', '97264C'])

figure.facecolor: FFFFFF
axes.facecolor: FFFFFF
savefig.facecolor: FFFFFF

text.color: 252629
axes.labelcolor: 252629
axes.titlecolor: 252629
xtick.labelcolor: 252629
ytick.labelcolor: 252629

axes.edgecolor: 5D5E62
xtick.color: 5D5E62
ytick.color: 5D5E62

# Latin font first, then East Asian; matplotlib >= 3.6 falls back per glyph along this list.
font.family: Arial, Helvetica, Meiryo UI, Hiragino Sans, Noto Sans JP, sans-serif
