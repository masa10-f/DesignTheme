# Theme 04 Slate & Teal (slate-teal), status: active
# Generated by scripts/build.py from themes/04-slate-teal/theme.json. Do not edit by hand.
# Colors: roles text / text-secondary / background. Color cycle: chart.series
# chart.series status: provisional (tentative proposal, needs review)

axes.prop_cycle: cycler('color', ['34485E', '3C7D9B', '5CA08B', 'B87252', '505700', '843B44'])

figure.facecolor: FFFFFF
axes.facecolor: FFFFFF
savefig.facecolor: FFFFFF

text.color: 242629
axes.labelcolor: 242629
axes.titlecolor: 242629
xtick.labelcolor: 242629
ytick.labelcolor: 242629

axes.edgecolor: 5C5F62
xtick.color: 5C5F62
ytick.color: 5C5F62

# Latin font first, then East Asian; matplotlib >= 3.6 falls back per glyph along this list.
font.family: Arial, Helvetica, Meiryo UI, Hiragino Sans, Noto Sans JP, sans-serif
